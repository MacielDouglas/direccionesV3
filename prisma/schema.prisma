// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  image         String?
  emailVerified Boolean @default(false)

  role       String?
  isSuperUser Boolean  @default(false)
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?
  theme String?
  language String @default("pt")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth
  sessions Session[]
  accounts Account[]

  // Identidade de domínio (1:1)
  person Person?

  @@map("user")
}

//////////////////////////////////////////////////////
// PERSON
//////////////////////////////////////////////////////

model Person {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?  @unique
  name           String
  role           String? // "member" | "admin" | "owner" | null (sem org)
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Card
  cardsOwned    Card[]      @relation("CardOwner")
  cardsAssigned Card[]      @relation("CardAssignedTo")
  createdCards  Card[]      @relation("CardCreatedBy")
  updatedCards  Card[]      @relation("CardUpdatedBy")
  cardEvents    CardEvent[] @relation("CardEventActor")

  // Address
  createdAddresses Address[] @relation("AddressCreatedBy")
  updatedAddresses Address[] @relation("AddressUpdatedBy")
  invitedAddresses Address[] @relation("InvitedAddresses")
  deletionRequests Address[] @relation("AddressDeletionRequests")

  // Survey
  surveysCreated   SurveyPin[] @relation("SurveyCreatedPins")
  surveysConfirmed SurveyPin[] @relation("SurveyConfirmedPins")

  // Agenda
  agendaConductor AgendaEvent[] @relation("AgendaEventConductor")

  // Invites
  inviteTokensCreated InviteToken[] @relation("InviteTokensCreated")
  inviteTokensUsed    InviteToken[] @relation("InviteTokensUsed")
  inviteTokens        InviteToken[] @relation("InviteTokenPerson")

  @@index([organizationId])
  @@map("person")
}

//////////////////////////////////////////////////////
// ADDRESS
//////////////////////////////////////////////////////

model Address {
  id String @id @default(uuid())

  type         String
  street       String
  number       String
  neighborhood String
  city         String


  //  Coordenadas GPS

  latitude  Float?
  longitude Float?

  image        String?
  info         String?
  businessName String?

  active    Boolean @default(true)
  confirmed Boolean @default(false)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Convite

  invited     Boolean @default(false)
  invitedByPersonId String?
  invitedBy   Person? @relation("InvitedAddresses", fields: [invitedByPersonId], references: [id], onDelete: SetNull)


  //  Auditoria

  createdByPersonId String
  createdBy         Person  @relation("AddressCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)

  updatedByPersonId String?
  updatedBy         Person? @relation("AddressUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)


  //  Relação com Card

  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Delete
  pendingDeletion        Boolean   @default(false)
  pendingDeletionAt      DateTime?
  pendingDeletionByPersonId String?

  requestedBy Person? @relation("AddressDeletionRequests", fields: [pendingDeletionByPersonId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([latitude, longitude])
  @@index([createdByPersonId])
  @@map("address")
}

//////////////////////////////////////////////////////
// CARD
//////////////////////////////////////////////////////

model Card {
  id     String @id @default(uuid())
  number Int

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Dono do Card
  ownerPersonId String?
  owner         Person? @relation("CardOwner", fields: [ownerPersonId], references: [id], onDelete: Cascade)

  // Auditoria
  createdByPersonId String
  createdBy         Person   @relation("CardCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)

  updatedByPersonId String?
  updatedBy         Person?  @relation("CardUpdatedBy", fields: [updatedByPersonId], references: [id], onDelete: SetNull)

  // Atribuição
  assignedPersonId String?
  assignedTo       Person?  @relation("CardAssignedTo", fields: [assignedPersonId], references: [id], onDelete: SetNull)

  // Relações
  addresses Address[]
  events    CardEvent[]

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([assignedPersonId])
  @@index([ownerPersonId])
  @@index([organizationId])
  @@map("card")
}


//////////////////////////////////////////////////////
// AUTH
//////////////////////////////////////////////////////

model Session {
  id     String @id
  token  String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  ipAddress String?
  userAgent String?

  impersonatedBy       String?
  activeOrganizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  providerId String
  accountId  String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

//////////////////////////////////////////////////////
// ORGANIZATION
//////////////////////////////////////////////////////

model Organization {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  persons     Person[]
  addresses   Address[]
  cards       Card[]
  surveys     Survey[]
  agenda      AgendaEvent[]
  agendaOption AgendaFieldOption[]

   inviteTokens InviteToken[]

  @@map("organization")
}

//////////////////////////////////////////////////////
// EVENTS
//////////////////////////////////////////////////////

model CardEvent {
  id String @id @default(uuid())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  personId String?
  person   Person? @relation("CardEventActor", fields: [personId], references: [id], onDelete: SetNull)

  action CardEventAction
  date   DateTime        @default(now())

  @@index([cardId])
  @@index([personId])
  @@map("card_event")
}

enum CardEventAction {
  ASSIGNED
  RETURNED
}

model Survey {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  pins           SurveyPin[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId])
  @@map("survey")
}

model SurveyPin {
  id            String    @id @default(cuid())
  surveyId      String
  survey        Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  latitude      Float
  longitude     Float
  status        PinStatus @default(PENDING)
  createdByPersonId   String?
  createdBy     Person?      @relation("SurveyCreatedPins", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  confirmedByPersonId String?
  confirmedBy   Person?     @relation("SurveyConfirmedPins", fields: [confirmedByPersonId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([surveyId])
  @@index([createdByPersonId])
  @@map("survey_pin")
}

enum PinStatus {
  PENDING     // vermelho  — marcado pelo usuário, não confirmado ainda
  SUGGESTED   // amarelo   — enviado por admin/owner
  CONFIRMED   // verde     — confirmado por qualquer membro
  CANCELLED   // cinza     — cancelado
}



//////////////////////////////////////////////////////
// AGENDA
//////////////////////////////////////////////////////

model AgendaEvent {
  id             String    @id @default(cuid())
  organizationId String
  date           DateTime
  time           String?
  conductorPersonId String?
  saida          String?
  tipo           String?
  territorio     String?
  info           String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conductor      Person?        @relation("AgendaEventConductor", fields: [conductorPersonId], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, date])
}

// ✅ Armazena opções salvas por campo e organização
model AgendaFieldOption {
  id             String   @id @default(cuid())
  organizationId String
  field          String   // "saida" | "tipo" | "territorio"
  value          String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([organizationId, field, value]) // ← sem duplicatas
  @@index([organizationId, field])
}


//////////////////////////////////////////////////////
// INVITATION
//////////////////////////////////////////////////////

model InviteToken {
  id             String    @id @default(cuid())
  token          String    @unique @default(cuid())
  type           TokenType @default(INVITE)
  organizationId String?
  role           String    @default("member")
  createdByPersonId String
  personId       String?
  expiresAt      DateTime
  usedAt         DateTime?
  usedByPersonId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Person        @relation("InviteTokensCreated", fields: [createdByPersonId], references: [id], onDelete: Cascade)
  person       Person?       @relation("InviteTokenPerson", fields: [personId], references: [id], onDelete: Cascade)
  usedBy       Person?       @relation("InviteTokensUsed", fields: [usedByPersonId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([token])
  @@index([organizationId])
  @@index([type])
  @@index([personId])
  @@map("invite_token")
}

enum TokenType {
  OWNER_ONBOARDING
  INVITE
}