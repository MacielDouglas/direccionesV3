{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.opencode",
      "!**/out",
      "!**/build",
      "!**/next-env.d.ts",
      "!**/public/sw.js",
      "!**/public/workbox-*.js",
      "!**/public/worker-*.js",
      "!**/public/swe-worker-*.js",
      "!**/public/fallback-*.js"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noApproximativeNumericConstant": "error",
        "noConsole": "warn",
        "noExplicitAny": "warn"
      },
      "style": {
        "noDefaultExport": "off",
        "useEnumInitializers": "off",
        "useImportType": "error",
        "useNodejsImportProtocol": "off",
        "noNamespace": "error"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "a11y": {
        "useKeyWithClickEvents": "warn",
        "useValidAriaValues": "error"
      }
    }
  }
}
